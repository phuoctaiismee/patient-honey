{
  "id": "reviews_cta",
  "type": "SharedSlice",
  "name": "ReviewsCTA",
  "description": "A section showcasing reviews from multiple platforms with counts and descriptions",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default variation of ReviewsCTA slice",
      "imageUrl": "",
      "primary": {
        "subheading": {
          "type": "Text",
          "config": {
            "label": "Subheading",
            "placeholder": "Had a Great Experience?"
          }
        },
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Heading",
            "placeholder": "We'd Love to Hear From You!",
            "allowTargetBlank": true,
            "single": "heading2"
          }
        },
        "background_image": {
          "type": "Image",
          "config": {
            "label": "Background Image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "reviews": {
          "type": "Group",
          "config": {
            "label": "Reviews",
            "fields": {
              "icon": {
                "type": "Image",
                "config": {
                  "label": "Platform Icon"
                }
              },
              "count": {
                "type": "Text",
                "config": {
                  "label": "Review Count",
                  "placeholder": "551+"
                }
              },
              "description": {
                "type": "Text",
                "config": {
                  "label": "Review Description",
                  "placeholder": "5.0-stars Google Reviews"
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}
        "backgroundImage": {
          "type": "Image",
          "config": {
            "label": "Background Image"
          }
        },
        "with_overlay": {
          "type": "Boolean",
          "config": {
            "label": "With Overlay",
            "placeholder_false": "false",
            "placeholder_true": "true",
            "default_value": false
          }
        }
